# Environment variable names used by MatchDistrict; configure values in the server/deployment environment.
# Required: live Supabase PostgreSQL pooler connection string.
DATABASE_URL=
# Required: root administrator email.
ADMIN_EMAIL=
# Required: root administrator password (stored as PBKDF2 hash in PostgreSQL).
ADMIN_PASSWORD=
# Required: high-entropy JWT signing/session encryption secret.
JWT_SECRET=
# Required: Supabase project URL for Auth, Realtime, and storage URL allow-listing.
SUPABASE_URL=
# Required: public Supabase anon key for browser/server Auth and browser Realtime.
SUPABASE_ANON_KEY=
# Optional: server-only key for Supabase Auth password synchronization; never expose to Vite/client code.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Resend email delivery API key.
RESEND_API_KEY=
# Optional when Resend is configured: sender identity.
RESEND_FROM_EMAIL=
# Optional: Cloudinary media upload/deletion configuration.
CLOUDINARY_CLOUD_NAME=
# Optional: Cloudinary media upload/deletion configuration.
CLOUDINARY_API_KEY=
# Optional: Cloudinary server-side media deletion configuration.
CLOUDINARY_API_SECRET=
# Optional: upload preset; defaults to matchdistrict_default.
CLOUDINARY_UPLOAD_PRESET=
# Optional legacy preset name read by server.js; defaults to matchdistrict_default.
VITE_CLOUDINARY_UPLOAD_PRESET=
# Optional: HTTP server port; defaults to 10000.
PORT=
# Optional: monitoring interval in seconds; defaults to 300.
MONITORING_INTERVAL_SECONDS=
# Optional: sponsorship routes; server defaults disabled, set false to hide the client entry point.
ENABLE_SPONSORSHIP=
# Optional: API origin for authenticator setup; defaults to same-origin.
VITE_API_URL=
# Optional: website support contact address.
VITE_SUPPORT_EMAIL=
# Optional: organizer support contact address.
VITE_ORGANIZER_SUPPORT_EMAIL=
# Optional: admin contact address.
VITE_ADMIN_EMAIL=
# Optional: privacy contact address.
VITE_PRIVACY_EMAIL=